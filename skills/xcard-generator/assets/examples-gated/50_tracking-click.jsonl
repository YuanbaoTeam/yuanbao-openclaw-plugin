{"version":"v1.0","updateComponents":{"surfaceId":"gallery-tracking-click","components":[{"id":"root","component":"Column","children":["title","intro","both-card","shapes-card","wrapped-card","negative-card"]},{"id":"title","component":"Text","text":"Tracking — Click","variant":"h2"},{"id":"intro","component":"Text","text":"Tap each row and watch the trace panel. A click carries the action's own anchor id, never the component's exposure one, and the global req_id and card_type are merged into every report.","variant":"body"},{"id":"both-card","component":"Card","children":["both-title","both-hint","fav-button"]},{"id":"both-title","component":"Text","text":"Exposure and click side by side","variant":"h4"},{"id":"both-hint","component":"Text","text":"This button declares both anchors. Scrolling it into view reports fav_expo; tapping it reports fav_click. The two never substitute for one another, and each carries its own `strategy` — the renderer passes both through without reading either, so the host is what makes them mean anything.","variant":"caption"},{"id":"fav-label","component":"Text","text":"Add to favourites"},{"id":"fav-button","component":"Button","child":"fav-label","variant":"primary","tracking":{"id":"fav_expo","params":{"P3":{"path":"/item/id"}},"strategy":"oncePerCard"},"action":{"tracking":{"id":"fav_click","params":{"P3":{"path":"/item/id"},"P4":"1"},"strategy":"everyExposure"},"event":{"name":"add_favorite","context":{"itemId":{"path":"/item/id"}}}}},{"id":"shapes-card","component":"Card","children":["shapes-title","shapes-hint","copy-button","share-row"]},{"id":"shapes-title","component":"Text","text":"Both action shapes, and IconButton","variant":"h4"},{"id":"shapes-hint","component":"Text","text":"An anchor sits inside the action either way — functionCall as readily as event.","variant":"caption"},{"id":"copy-label","component":"Text","text":"Copy link (functionCall)"},{"id":"copy-button","component":"Button","child":"copy-label","action":{"trac